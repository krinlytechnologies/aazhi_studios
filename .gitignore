# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# cloudflare / wrangler
.wrangler
.dev.vars*

# typescript
*.tsbuildinfo
next-env.d.ts

# full-quality source masters for the cinematic hero video (re-encoded,
# smaller copies live in public/videos and ARE committed — only these
# root-level originals are excluded; the leading slash matters here, since
# a bare pattern would also match public/videos/villa-journey.mp4)
/villa-journey.mp4
/arrival.mp4